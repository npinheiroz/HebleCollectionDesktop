<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 24; -fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Botão Voltar -->
      <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand; -fx-padding: 0;" text="← Voltar ao Painel">
         <font>
            <Font size="13.0" />
         </font>
      </Button>

      <!-- Cabeçalho -->
      <VBox spacing="4.0">
         <children>
            <Label text="Cadastro de Produto" textFill="#0F172A">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Preencha as informações do produto abaixo" textFill="#64748B">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- Cartão do Formulário -->
      <VBox spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
         <children>

            <!-- Linha 1: ID e Nome -->
            <HBox spacing="16.0">
               <children>
                  <VBox prefWidth="120.0" spacing="6.0">
                     <children>
                        <Label text="ID" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtId" promptText="0000" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 8;" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Nome do Produto" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNome" promptText="Ex: Calça Moletom" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 8;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Linha 2: Descrição -->
            <VBox spacing="6.0">
               <children>
                  <Label text="Descrição" textFill="#0F172A">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="txtDescricao" prefHeight="90.0" promptText="Ex: Calça moletom com bolsos laterais, cor preta." style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" wrapText="true" />
               </children>
            </VBox>

            <!-- Linha 3: Preço e Quantidade -->
            <HBox spacing="16.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Preço (R$)" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtPreco" promptText="100.00" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 8;" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Quantidade Disponível" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtQuantidade" promptText="2" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 8;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Linha 4: Status e Empresa -->
            <HBox spacing="16.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Status" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cbStatus" maxWidth="1.7976931348623157E308" promptText="Selecione o status" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 3;" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Empresa" textFill="#0F172A">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtEmpresa" promptText="Ex: Mormaii" style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-padding: 8;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Linha 5: Botões de Ação -->
            <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 12 0 0 0;">
               <children>
                  <Button fx:id="btnSalvar" mnemonicParsing="false" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #d6b667; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Finalizar">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</VBox>