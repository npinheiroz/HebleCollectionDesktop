<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.heblecollectiondesktop.controller.ControllerDashboard">

    <left>
        <VBox prefWidth="240.0" spacing="12.0" style="-fx-background-color: #111118; -fx-padding: 24;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Pane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" />
                        <Label text="Heble Collection" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #1E293B; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand;" text="Visão Geral">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-background-radius: 8; -fx-cursor: hand;" text="Estoque / Produtos">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-background-radius: 8; -fx-cursor: hand;" text="Vendas">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-background-radius: 8; -fx-cursor: hand;" text="Configurações">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>


    <center>
        <VBox spacing="24.0" style="-fx-padding: 30;" BorderPane.alignment="CENTER">
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Painel Principal" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Acompanhamento geral em tempo real" textFill="#64748B">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblUsuarioLogado" style="-fx-background-color: #E2E8F0; -fx-padding: 8 16; -fx-background-radius: 20;" text="Operador: Conectando..." textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>


                <HBox spacing="20.0">
                    <children>
                        <VBox prefHeight="100.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 20;">
                            <effect>
                                <DropShadow blurType="THREE_PASS_BOX" height="15.0" radius="7.0" width="15.0">
                                    <color>
                                        <Color opacity="0.05" />
                                    </color>
                                </DropShadow>
                            </effect>
                            <children>
                                <Label text="Total de Vendas" textFill="#64748B">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Label text="R$ 14.850,00" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox prefHeight="100.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 20;">
                            <effect>
                                <DropShadow blurType="THREE_PASS_BOX" height="15.0" radius="7.0" width="15.0">
                                    <color>
                                        <Color opacity="0.05" />
                                    </color>
                                </DropShadow>
                            </effect>
                            <children>
                                <Label text="Produtos em Estoque" textFill="#64748B">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Label text="324 itens" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox prefHeight="100.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 20;">
                            <effect>
                                <DropShadow blurType="THREE_PASS_BOX" height="15.0" radius="7.0" width="15.0">
                                    <color>
                                        <Color opacity="0.05" />
                                    </color>
                                </DropShadow>
                            </effect>
                            <children>
                                <Label text="Pedidos Pendentes" textFill="#64748B">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Label text="12 pedidos" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>


                <VBox maxHeight="1.7976931348623157E308" prefHeight="440.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                    <effect>
                        <DropShadow blurType="THREE_PASS_BOX" height="15.0" radius="7.0" width="15.0">
                            <color>
                                <Color opacity="0.05" />
                            </color>
                        </DropShadow>
                    </effect>
                    <children>
                        <Label text="Atividade Recente" textFill="#0F172A">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>